# Local development. Copy to .env and fill in ADSB_USER_AGENT.
DATABASE_URL=postgres://aerotrack:aerotrack@localhost:5433/aerotrack
TEST_DATABASE_URL=postgres://aerotrack:aerotrack@localhost:5433/aerotrack_test
PORT=8080
ADSB_BASE_URL=https://api.adsb.lol
ADSB_USER_AGENT=AeroTrack/0.1 (+you@example.com)
ADSB_API_KEY=
POLL_INTERVAL_MS=10000
# OpenSky Network API client (Australia-wide overview). From your OpenSky account page -> API client.
# Server only. Leave empty to disable the overview layer.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
CORS_ORIGIN=http://localhost:3000
ADMIN_TOKEN=change-me
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aerotrack
R2_PUBLIC_BASE_URL=
ANTHROPIC_API_KEY=
