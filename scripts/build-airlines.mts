// Generates packages/shared/src/airlines.ts from OpenFlights (ODbL), SPEC 5.4.
// Usage: pnpm build:airlines
import { writeFileSync } from "node:fs";
import { parseCsv } from "./csv.mts";

const SOURCE = "https://raw.githubusercontent.com/jpatokal/openflights/master/data/airlines.dat";
const OUT = new URL("../packages/shared/src/airlines.ts", import.meta.url);

const res = await fetch(SOURCE);
if (!res.ok) throw new Error(`OpenFlights download failed: ${res.status}`);
// Columns: id, name, alias, IATA, ICAO, callsign, country, active (no header row).
const rows = parseCsv(await res.text());
const airlines = rows
  .filter((r) => r[7] === "Y" && /^[A-Z0-9]{2}$/.test(r[3] ?? "") && /^[A-Z]{3}$/.test(r[4] ?? ""))
  .map((r) => ({ iata: r[3]!, icao: r[4]!, name: r[1]!.trim() }))
  .sort((a, b) => a.iata.localeCompare(b.iata) || a.icao.localeCompare(b.icao));

const body = `// Generated by scripts/build-airlines.mts from OpenFlights (ODbL). Do not edit by hand.
// Source: ${SOURCE}
// Generated: ${new Date().toISOString().slice(0, 10)}. Active airlines with both an IATA and an ICAO code.
// The source was last updated in 2017, so it is stale: see SPEC 5.4.

export interface Airline {
  iata: string;
  icao: string;
  name: string;
}

export const AIRLINES: readonly Airline[] = ${JSON.stringify(airlines)};
`;
writeFileSync(OUT, body);
console.log(`Wrote ${airlines.length} airlines to ${OUT.pathname}`);
