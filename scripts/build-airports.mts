// Generates airport lists from OurAirports (public domain), SPEC 5.5 and 11.11.
// Usage: pnpm build:airports          -> packages/shared/src/airports.ts (Sydney region, used by the browser too)
//        pnpm build:airports --world  -> apps/api/src/data/worldAirports.ts (server only, for followed flights)
import { writeFileSync } from "node:fs";
import { THRESHOLDS } from "../packages/shared/src/config/thresholds";

const SOURCE = "https://davidmegginson.github.io/ourairports-data/airports.csv";
const MAX_NM = 70;
const WORLD = process.argv.includes("--world");
const OUT = WORLD
  ? new URL("../apps/api/src/data/worldAirports.ts", import.meta.url)
  : new URL("../packages/shared/src/airports.ts", import.meta.url);

/** Minimal RFC 4180 parser: quoted fields, escaped quotes, commas and newlines inside quotes. */
function parseCsv(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let field = "";
  let quoted = false;
  const endField = () => {
    row.push(field);
    field = "";
  };
  for (let i = 0; i < text.length; i++) {
    const c = text[i]!;
    if (quoted) {
      if (c === '"' && text[i + 1] === '"') {
        field += '"';
        i++;
      } else if (c === '"') quoted = false;
      else field += c;
    } else if (c === '"') quoted = true;
    else if (c === ",") endField();
    else if (c === "\n") {
      endField();
      rows.push(row);
      row = [];
    } else if (c !== "\r") field += c;
  }
  if (field || row.length) {
    endField();
    rows.push(row);
  }
  return rows;
}

function distanceNm(lat1: number, lon1: number, lat2: number, lon2: number): number {
  const r = (d: number) => (d * Math.PI) / 180;
  const a = Math.sin(r(lat2 - lat1) / 2) ** 2 + Math.cos(r(lat1)) * Math.cos(r(lat2)) * Math.sin(r(lon2 - lon1) / 2) ** 2;
  return 2 * 3440.065 * Math.asin(Math.sqrt(a));
}

const res = await fetch(SOURCE, { headers: { "User-Agent": process.env.ADSB_USER_AGENT ?? "AeroTrack/0.1 build-airports" } });
if (!res.ok) throw new Error(`OurAirports download failed: ${res.status}`);
const [header, ...rows] = parseCsv(await res.text());
const col = (name: string) => header!.indexOf(name);
const ICAO_STYLE = /^Y[A-Z]{3}$/;
const { lat: cLat, lon: cLon } = THRESHOLDS.poll.centre;

const toAirport = (r: string[], ident: string | undefined) => ({
  ident,
  name: r[col("name")]!,
  // 6 decimal places is ~10 cm; some source values carry more digits than a float can hold.
  lat: Math.round(Number(r[col("latitude_deg")]) * 1e6) / 1e6,
  lon: Math.round(Number(r[col("longitude_deg")]) * 1e6) / 1e6,
  elevationFt: r[col("elevation_ft")] ? Number(r[col("elevation_ft")]) : null,
});

const sydneyRegion = () =>
  rows
    .filter((r) => r[col("iso_country")] === "AU" && ["large_airport", "medium_airport", "small_airport"].includes(r[col("type")]!))
    .map((r) => toAirport(r, [r[col("icao_code")], r[col("ident")]].find((v) => v && ICAO_STYLE.test(v))))
    .filter((a): a is typeof a & { ident: string } => !!a.ident && distanceNm(cLat, cLon, a.lat, a.lon) <= MAX_NM);

// Worldwide: large and medium airports with an IATA code (the ones airliners use).
const world = () =>
  rows
    .filter((r) => ["large_airport", "medium_airport"].includes(r[col("type")]!) && r[col("iata_code")])
    .map((r) => toAirport(r, r[col("icao_code")] || r[col("gps_code")] || r[col("ident")]))
    .filter((a): a is typeof a & { ident: string } => !!a.ident && Number.isFinite(a.lat) && Number.isFinite(a.lon));

const airports = (WORLD ? world() : sydneyRegion()).sort((a, b) => a.ident.localeCompare(b.ident));

const banner = `// Generated by scripts/build-airports.mts from OurAirports (public domain). Do not edit by hand.
// Source: ${SOURCE}
// Generated: ${new Date().toISOString().slice(0, 10)}. ${
  WORLD ? "Large and medium airports with an IATA code, worldwide." : `AU airports with an ICAO-style ident within ${MAX_NM} nm of the poll centre.`
}
`;
const body = WORLD
  ? `${banner}
import type { Airport } from "@aerotrack/shared";

export const WORLD_AIRPORTS: readonly Airport[] = ${JSON.stringify(airports)};
`
  : `${banner}
export interface Airport {
  ident: string;
  name: string;
  lat: number;
  lon: number;
  elevationFt: number | null;
}

export const AIRPORTS: readonly Airport[] = ${JSON.stringify(airports, null, 2)};
`;
writeFileSync(OUT, body);
console.log(`Wrote ${airports.length} airports to ${OUT.pathname}`);
